# Supabase (Project Settings -> API). Service role key is server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared admin password for committee members, and a long random string
# (e.g. `openssl rand -hex 32`) used to sign the login cookie.
ADMIN_PASSWORD=
SESSION_SECRET=
