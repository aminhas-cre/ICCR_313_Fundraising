# Supabase (Project Settings -> API). Service role key is server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared admin password for committee members, and a long random string
# (e.g. `openssl rand -hex 32`) used to sign the login cookie.
ADMIN_PASSWORD=
SESSION_SECRET=

# Email (optional; emails are skipped until both are set). Resend: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=ICCR 313 <donations@your-verified-domain.org>
EMAIL_REPLY_TO=
# Optional: public site URL used in email links (defaults to the request host)
NEXT_PUBLIC_SITE_URL=
